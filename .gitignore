# Node
node_modules/
dist/
*.tsbuildinfo
.vite/
.eslintcache

# Rust
target/
**/*.rs.bk
Cargo.lock

# WASM build outputs (regenerated by `npm run wasm:build`)
src/wasm/pkg/
tests/wasm-binding/pkg/

# Bundled sample is a build artifact, copied from the `bundled: true` corpus entry
public/samples/wing-sample.bbl

# Tauri
src-tauri/target/
src-tauri/Cargo.lock

# Private corpus — personal regression logs that we never publish
tests/corpus-private/

# Working scratch from agent runs
_firmware_cache/
.scratch/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/

# Env / secrets
.env
.env.local
.env.*.local
*.local

# Don't gitignore .vscode — we ship recommended extensions + settings
!.vscode/

# But do ignore per-user VS Code state
.vscode/.workspace.json

# Per-user Claude Code permissions (the shared allowlist is .claude/settings.json)
.claude/settings.local.json
