{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions: core + native file open dialog + reading the chosen .bbl/.bfl/.txt files by absolute path",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "**/*.bbl" },
        { "path": "**/*.BBL" },
        { "path": "**/*.bfl" },
        { "path": "**/*.BFL" },
        { "path": "**/*.txt" }
      ]
    }
  ]
}
